# Betfair API
BETFAIR_APP_KEY=your_betfair_app_key_here
# Optional endpoint override (default works for most users)
BETFAIR_BETTING_API_URL=https://api-au.betfair.com/exchange/betting/json-rpc/v1
# Usually required for API-NG calls. Use your Betfair SSO/session token.
BETFAIR_SESSION_TOKEN=your_betfair_session_token_here
# Optional: route Betfair calls through your own AU proxy (e.g. Oracle Cloud)
BETFAIR_PROXY_URL=
BETFAIR_PROXY_TOKEN=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# Service role key — used server-side to persist runner names (bypasses RLS). Find in Supabase dashboard → Project Settings → API.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
NEXT_PUBLIC_SITE_URL=https://your-production-domain.vercel.app

# Email reminders (Resend)
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=notifications@yourdomain.com

# Secures /api/race-reminders endpoint
CRON_SECRET=your_random_secret

# Web Push Notifications (VAPID)
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key
